<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product Template Form View Inherit -->
    <record id="product_template_form_view_transit_inherit" model="ir.ui.view">
        <field name="name">product.template.form.transit.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <!-- Smart Button for Product Received -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="has_pending_transit" invisible="1"/>
                <button name="action_open_product_receipt" type="object"
                        class="oe_stat_button" icon="fa-inbox"
                        invisible="not has_pending_transit">
                    <div class="o_stat_info">
                        <span class="o_stat_value text-success">
                            <field name="pending_transit_qty" widget="statinfo" string="In-Transit"/>
                        </span>
                        <span class="o_stat_text text-primary font-weight-bold">Product Received?</span>
                    </div>
                </button>
            </xpath>

            <!-- Prominent Receipt Banner inside Sheet -->
            <xpath expr="//sheet" position="before">
                <field name="has_pending_transit" invisible="1"/>
                <div class="alert alert-info d-flex align-items-center justify-content-between p-3 mb-3 shadow-sm rounded border-start border-4 border-info"
                     role="alert" invisible="not has_pending_transit">
                    <div class="d-flex align-items-center">
                        <i class="fa fa-truck fa-2x me-3 text-info" title="Incoming Shipment"/>
                        <div>
                            <h5 class="alert-heading mb-1 text-info fw-bold">Incoming Shipment Awaiting Your Confirmation!</h5>
                            <span>
                                <strong><field name="pending_transit_qty" readonly="1" class="oe_inline"/> <field name="uom_name" readonly="1" class="oe_inline"/></strong> of this product has been transferred from Main Store and is currently in transit to <strong><field name="user_warehouse_name" readonly="1" class="oe_inline"/></strong>.
                                Click below to confirm that it has arrived and add it to your warehouse inventory.
                            </span>
                        </div>
                    </div>
                    <button name="action_confirm_product_receipt_now" type="object"
                            string="Confirm Received (Add to Inventory)"
                            class="btn btn-success btn-lg shadow-sm ms-3 text-nowrap"
                            icon="fa-check-circle"/>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Product Product (Variant) Form View Inherit -->
    <record id="product_normal_form_view_transit_inherit" model="ir.ui.view">
        <field name="name">product.product.form.transit.inherit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="has_pending_transit" invisible="1"/>
                <button name="action_open_product_receipt" type="object"
                        class="oe_stat_button" icon="fa-inbox"
                        invisible="not has_pending_transit">
                    <div class="o_stat_info">
                        <span class="o_stat_value text-success">
                            <field name="pending_transit_qty" widget="statinfo" string="In-Transit"/>
                        </span>
                        <span class="o_stat_text text-primary font-weight-bold">Product Received?</span>
                    </div>
                </button>
            </xpath>

            <xpath expr="//sheet" position="before">
                <field name="has_pending_transit" invisible="1"/>
                <div class="alert alert-info d-flex align-items-center justify-content-between p-3 mb-3 shadow-sm rounded border-start border-4 border-info"
                     role="alert" invisible="not has_pending_transit">
                    <div class="d-flex align-items-center">
                        <i class="fa fa-truck fa-2x me-3 text-info" title="Incoming Shipment"/>
                        <div>
                            <h5 class="alert-heading mb-1 text-info fw-bold">Incoming Shipment Awaiting Your Confirmation!</h5>
                            <span>
                                <strong><field name="pending_transit_qty" readonly="1" class="oe_inline"/> <field name="uom_name" readonly="1" class="oe_inline"/></strong> is currently in transit to <strong><field name="user_warehouse_name" readonly="1" class="oe_inline"/></strong>.
                            </span>
                        </div>
                    </div>
                    <button name="action_confirm_product_receipt_now" type="object"
                            string="Confirm Received (Add to Inventory)"
                            class="btn btn-success btn-lg shadow-sm ms-3 text-nowrap"
                            icon="fa-check-circle"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
